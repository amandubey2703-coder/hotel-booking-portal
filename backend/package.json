{
  "name": "hotel-booking-backend",
  "version": "1.0.0",
  "description": "Full-Stack Hotel Booking Portal REST API",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --runInBand --detectOpenHandles --forceExit",
    "test:watch": "jest --watch",
    "db:setup": "node ../database/setup.js",
    "db:view": "node scripts/viewDb.js"
  },
  "keywords": [
    "hotel-booking",
    "express",
    "mysql",
    "rest-api"
  ],
  "author": "Full-Stack Engineer",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "mysql2": "^3.11.4"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.7",
    "puppeteer-core": "^25.17.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "verbose": true
  }
}
